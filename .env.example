# Anthropic Claude API Key
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Brave Search API Key
# Get yours at: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=BSAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude models (optional - defaults are current models)
# Override to update models without a code change. If a configured model is
# ever retired, the app auto-falls back to a current model and logs a warning.
# FAST_MODEL=claude-haiku-4-5
# ANALYSIS_MODEL=claude-sonnet-4-6

# Vercel KV (optional - for production storage)
# Automatically provided by Vercel when you add KV to your project
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
