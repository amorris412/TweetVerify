{
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/check-tweet.ts": {
      "maxDuration": 60,
      "includeFiles": "api/lib/**"
    },
    "api/get-result.ts": {
      "maxDuration": 60,
      "includeFiles": "api/lib/**"
    },
    "api/result/[id].ts": {
      "maxDuration": 10,
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/result/:id",
      "destination": "/api/result/:id"
    }
  ]
}
